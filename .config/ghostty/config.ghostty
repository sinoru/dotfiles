font-family = SF Mono
font-family = Noto Sans Mono CJK JP
font-family = Noto Sans Mono CJK KR
font-size = 12
font-thicken = false
background = #1C1C1C
foreground = #E0E0E0
selection-foreground = #E0E0E0
selection-background = #273D4C
palette = 000=#35424C
palette = 001=#B45648
palette = 002=#6CAA71
palette = 003=#C4AC62
palette = 004=#6D96B4
palette = 005=#BD7BCD
palette = 006=#7CCBCD
palette = 007=#DEE5EB
palette = 008=#465C6D
palette = 009=#DF6C5A
palette = 010=#79BE7E
palette = 011=#E5C872
palette = 012=#67B5ED
palette = 013=#D389E5
palette = 014=#84DDE0
palette = 015=#E5EFF5
palette-generate = true
cursor-color = #7F7F7F
cursor-style = block
cursor-style-blink = false
background-opacity = 0.95
background-blur = 25
notify-on-command-finish = unfocused
wait-after-command = true
scrollback-limit = 104857600
working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = false
window-inherit-font-size = false
window-height = 30
window-width = 120
window-new-tab-position = end
image-storage-limit = 1073741824
shell-integration-features = no-cursor,sudo,ssh-env
macos-titlebar-style = native
bold-color = #EDEDED
bell-features = system,no-audio,attention,title,no-border
auto-update = check
